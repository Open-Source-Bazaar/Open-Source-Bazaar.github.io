{
  "name": "@open-source-bazaar/web-site",
  "version": "1.0.0",
  "description": "Open Source Bazaar web-site",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "install": "pnpx git-utility download https://github.com/Open-Source-Bazaar/key-vault main Open-Source-Bazaar.github.io  ||  true",
    "postinstall": "next typegen --webpack",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@koa/router": "^15.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@serwist/next": "^9.5.13",
    "core-js": "^3.51.0",
    "echarts-jsx": "^0.6.0",
    "file-type": "^22.2.0",
    "idea-react": "^2.3.5",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-jwt": "^4.0.4",
    "koajax": "^3.3.1",
    "license-filter": "^0.2.5",
    "marked": "^18.1.2",
    "mime": "^4.1.1",
    "mobx": "^7.1.3",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-lark": "^2.10.2",
    "mobx-react": "^10.0.3",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "mobx-restful-table": "^2.7.8",
    "mobx-strapi": "^0.8.1",
    "next": "16.4.3",
    "next-ssr-middleware": "^1.1.5",
    "nodemailer": "^10.2.1",
    "open-react-map": "^0.9.1",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-typed-component": "^1.0.6",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "serwist": "^9.5.13",
    "web-utility": "^4.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-idea2app-next-js": "^0.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "lint-staged": "^17.6.0",
    "next-with-less": "^3.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write"
  }
}
