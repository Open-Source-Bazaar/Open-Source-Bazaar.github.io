{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-source-bazaar",
  "preview_urls": true,
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
